# Copy to .env.production and fill in real values. Never commit the filled-in file.

# Your domain. DNS needs an A/AAAA record for this AND for *.{this} pointing
# at the server's IP - one wildcard record covers every restaurant's
# subdomain automatically, no per-restaurant DNS work.
APP_DOMAIN=example.com

# Cloudflare API token with Zone:DNS:Edit permission on APP_DOMAIN's zone -
# used for the wildcard TLS certificate's DNS-01 challenge. If you're not on
# Cloudflare, swap the DNS module in deploy/Caddy.Dockerfile and this var
# for your provider's equivalent (see https://github.com/caddy-dns).
CLOUDFLARE_API_TOKEN=

# Generate real random secrets, e.g.: openssl rand -base64 48
JWT_SECRET=
REFRESH_SECRET=

# Database
DB_NAME=posq
DB_USER=posq
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Stripe - platform subscription billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=

# Single-tenant fallback branch id for requests that can't resolve a tenant
# from the Host header (leave blank once every restaurant has its own
# subdomain in real use).
DEFAULT_BRANCH_ID=
