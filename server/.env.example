# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=devsecretchange
REFRESH_SECRET=devrefreshsecret
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# Database: DB_TYPE=sqlite3 (default) or mysql
DB_TYPE=sqlite3
DB_PATH=./data/posq.db

# Database (only used when DB_TYPE=mysql; connects via mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=posq
DB_USER=posq
DB_PASSWORD=posq

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=200

# Stripe - order payments (customer paying the restaurant)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe - platform subscription billing (restaurant paying the platform)
# Same Stripe account as above is fine; this is a separate webhook endpoint
# in the Stripe dashboard (Checkout/Subscription/Invoice events) with its
# own signing secret.
STRIPE_BILLING_WEBHOOK_SECRET=

# Printer service
PRINTER_SERVICE_URL=http://localhost:4000
