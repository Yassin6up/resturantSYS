# Reverse proxy + automatic HTTPS for POSQ.
#
# Three host patterns:
#   {$APP_DOMAIN}          - marketing/landing site
#   admin.{$APP_DOMAIN}    - your super-admin console
#   *.{$APP_DOMAIN}        - every restaurant's own subdomain (automatic -
#                             no DNS work needed per restaurant, the wildcard
#                             record + wildcard cert cover all of them)
#
# The wildcard cert needs a DNS-01 challenge (HTTP-01 can't issue wildcard
# certs), which is why this is built with the Cloudflare DNS module - see
# Caddy.Dockerfile. Swap `dns cloudflare` below for another provider's Caddy
# DNS module if you're not on Cloudflare.

{$APP_DOMAIN} {
	encode gzip
	reverse_proxy frontend:5173
}

admin.{$APP_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3001
	}
	handle /uploads/* {
		reverse_proxy api:3001
	}
	handle /socket.io/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy frontend:5173
	}
}

*.{$APP_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode gzip

	handle /api/* {
		reverse_proxy api:3001
	}
	handle /uploads/* {
		reverse_proxy api:3001
	}
	handle /socket.io/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy frontend:5173
	}
}
